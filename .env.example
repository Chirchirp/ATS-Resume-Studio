# Phase 4 platform service. Generate a different random value for each secret.
ATS_AUTH_SECRET=
ATS_DATA_SECRET=

# Local defaults
ATS_PLATFORM_DB=data/platform.db
ATS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ATS_INLINE_JOBS=true
ATS_JOB_WORKERS=2

# Optional AI providers used by the existing Streamlit app.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Stable signed Streamlit browser sessions and encrypted recovery snapshots.
# Use a random value of at least 32 characters in Streamlit Secrets.
APP_SESSION_SECRET=
